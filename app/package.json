    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.14.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "~5.6.3",
    "vite": "^6.4.6",
    "vite-plugin-pwa": "^2.0.0",
