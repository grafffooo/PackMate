{
  "name": "packmate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build ../crates/dieline-wasm --release --target web --out-dir ../../app/wasm --out-name dieline",
    "dev": "pnpm wasm && vite",
